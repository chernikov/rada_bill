# ========================================
# Application Configuration
# ========================================

# Application mode (true for development)
DEBUG=false

# Application name and version
APP_NAME="Bills Analyzer"
VERSION="1.0.0"

# ========================================
# Google Cloud Configuration
# ========================================

# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT=gen-lang-client-0955618410

# Google Cloud Storage bucket for documents
GCS_BUCKET_NAME=learn-documents-prod

# ========================================
# Google Gemini AI Configuration
# ========================================

# Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_google_api_key_here

# Gemini model to use
GEMINI_MODEL=gemini-1.5-pro

# ========================================
# Firebase / Firestore Configuration
# ========================================

# Path to Firebase service account JSON (optional, uses Application Default Credentials in Cloud Run)
FIREBASE_CREDENTIALS=

# Firestore database name
FIRESTORE_DATABASE=(default)

# ========================================
# Telegram Bot Configuration
# ========================================

# Bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Webhook URL for production (leave empty for local development with polling)
# Format: https://your-service.run.app/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=

# Secret token for webhook security (1-256 chars, required for webhook mode)
# Generate: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
TELEGRAM_SECRET_TOKEN=

# ========================================
# API Server Configuration
# ========================================

# API host (0.0.0.0 for all interfaces in production)
API_HOST=0.0.0.0

# API port (8080 for Cloud Run, 8000 for local)
API_PORT=8080

# Number of worker processes (1 for development, 4+ for production)
API_WORKERS=4

# ========================================
# Parliament Website Configuration
# ========================================

# Base URLs (don't change unless rada.gov.ua changes)
RADA_SEARCH_URL=https://itd.rada.gov.ua/billinfo/Bills/searchResults
RADA_DOWNLOAD_URL=https://itd.rada.gov.ua/billinfo/api/file/download/

# ========================================
# Rate Limiting and Retries
# ========================================

# Delay between document downloads (seconds)
DOWNLOAD_DELAY=0.5

# Delay between API calls (seconds)
API_DELAY=2.0

# Maximum retry attempts
MAX_RETRIES=3

# ========================================
# Logging Configuration
# ========================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json or text
LOG_FORMAT=json

# ========================================
# Legacy Configuration (deprecated)
# ========================================

# TELEGRAM_CHAT_ID - no longer used, bot gets chat_id from user messages
# BILL_ID - no longer used, bill ID provided via API calls
